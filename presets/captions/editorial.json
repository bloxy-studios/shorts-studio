{
  "id": "editorial",
  "version": "1.0.0",
  "name": "Editorial",
  "description": "Measured phrasing in Instrument Serif with a refined italic accent on meaningful words and a gentle rise-in.",
  "fonts": [
    {
      "family": "Instrument Serif",
      "file": "InstrumentSerif-Regular.ttf",
      "weight": 400,
      "style": "normal"
    },
    {
      "family": "Instrument Serif",
      "file": "InstrumentSerif-Italic.ttf",
      "weight": 400,
      "style": "italic"
    }
  ],
  "base": {
    "family": "Instrument Serif",
    "weight": 400,
    "sizePx": 82,
    "color": "#FFFFFF",
    "stroke": null,
    "shadow": "0 2px 18px rgba(0,0,0,0.6), 0 1px 2px rgba(0,0,0,0.7)",
    "box": null,
    "lineHeight": 1.05,
    "letterSpacingEm": -0.005,
    "case": "as-spoken"
  },
  "emphasis": {
    "mode": "semantic",
    "treatment": {
      "style": "italic",
      "color": "#F3D8A8"
    },
    "maxWordsPerChunk": 1
  },
  "grouping": {
    "minWords": 2,
    "maxWords": 7,
    "maxCharsPerLine": 24,
    "maxLines": 2,
    "pauseSplitMs": 450,
    "minChunkMs": 700,
    "maxChunkMs": 3400,
    "holdAfterMs": 320,
    "maxReadingCps": 20
  },
  "placement": {
    "zone": {
      "y0": 1200,
      "y1": 1480
    },
    "maxWidthPx": 860,
    "align": "center"
  },
  "animation": {
    "enter": "rise",
    "exit": "fade",
    "durationMs": 220,
    "intensity": 0.3
  },
  "emoji": false,
  "censor": "none"
}
